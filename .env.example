# MyHealth Uganda - Environment Configuration
# Copy this file to .env and update values for your environment

# Django
DJANGO_SECRET_KEY=generate-a-strong-random-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for production, SQLite for local dev)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=myhealth_db
# DB_USER=myhealth_user
# DB_PASSWORD=strong-password-here
# DB_HOST=localhost
# DB_PORT=5432

# Encryption key for PII fields (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=change-me-generate-with-cryptography-fernet

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File storage (local for MVP, S3 for production)
FILE_STORAGE_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=myhealth-documents
# AWS_S3_ENDPOINT_URL=
